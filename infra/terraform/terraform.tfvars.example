# POD99 Terraform Configuration Example
# Copie este arquivo para terraform.tfvars e ajuste conforme necessário

# ============================================================================
# AWS Configuration
# ============================================================================

aws_region  = "us-east-1"
environment = "prod"
app_name    = "pod99"

# ============================================================================
# DynamoDB Configuration
# ============================================================================

enable_pitr            = true
dynamodb_billing_mode  = "PAY_PER_REQUEST"

# ============================================================================
# SQS Configuration
# ============================================================================

sqs_message_retention_seconds = 86400  # 24 horas
sqs_max_receive_count         = 3      # Retentar 3× antes de DLQ

# ============================================================================
# API Gateway: Rate Limiting & Quotas
# ============================================================================

# Taxa de requisições por segundo
api_rate_limit  = 1000

# Burst (requisições simultâneas)
api_burst_limit = 100

# Quota diária
api_quota_limit = 1000000  # 1 milhão req/dia

# ============================================================================
# Authorization (OAuth2 / Cognito)
# ============================================================================

cognito_user_pool_id = "us-east-1_XXXXXXXXX"
cognito_client_id    = "XXXXXXXXXXXXXXXXXXXXX"

# ============================================================================
# Network (ALB/NLB Integration)
# ============================================================================

nlb_dns_name = "pod99-nlb-1234567890.us-east-1.elb.amazonaws.com"

# ============================================================================
# Monitoring & Logging
# ============================================================================

enable_xray                = true
enable_detailed_monitoring = true
log_retention_days         = 7
alarm_sns_topic_arn        = "arn:aws:sns:us-east-1:123456789012:pod99-alerts"

# ============================================================================
# Tags
# ============================================================================

additional_tags = {
  CostCenter  = "Engineering"
  Owner       = "POD99-Team"
  Environment = "prod"
  Project     = "FinTech-Authorization"
}
